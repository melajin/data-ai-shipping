{
  "metric_definitions": {
    "후보 유지율 (Candidate Retention Rate)": {
      "설명": "조건 확장 시 선택된 후보 선박이 후보군에 계속 잔존하는 비율",
      "세부지표": {
        "retention_subsequent_mean": "선정 티어 이후 후속 CASCADE 조건 중 후보가 존재하는 조건들에서 선정 선박이 후보군에 포함된 비율",
        "retention_base_rate": "기준 조건 (w=1h, r=5km) 후보군에 선정 선박이 포함된 비율",
        "retention_widest_rate": "최대 관측창 (w=6h, r=20km) 후보군에 선정 선박이 포함된 비율 (단조 확장 시 이론상 100%)"
      }
    },
    "단일성 유지율 (Uniqueness Retention Rate)": {
      "설명": "좁은 조건에서 단일 후보였던 배가 조건 확장 후에도 여타 경합 선박의 진입 없이 유일한 후보로 남는 비율",
      "세부지표": {
        "unique_subsequent_mean": "후속 CASCADE 조건들에서 추가 경합 선박 없이 단일 후보 상태를 유지한 비율",
        "unique_base_rate": "기준 조건 (w=1h, r=5km)에서 유일한 단일 후보로 유지된 비율",
        "unique_widest_rate": "최대 관측창 (w=6h, r=20km)에서 유일한 단일 후보로 유지된 비율"
      }
    },
    "대표 신원 안정성 (Representative Identity Stability)": {
      "설명": "조건 변경 시 선택되는 선박 신원의 일관성 및 충돌 부재 비율",
      "세부지표": {
        "conflict_free_rate": "모든 9개 CASCADE 조건에 걸쳐 신원 불일치가 전혀 발생하지 않은 사건 비율 (1 - conflict)",
        "id_match_single_subsequent_mean": "후속 조건에서 단일 후보가 다시 출현했을 때, 최초 선정 선박과 동일 선박일 확률"
      }
    }
  },
