{
  "experiment": "exp01",
  "title": "304 feature S6-controlled early stopping and sample weighting",
  "status": "fixed before OUTER evaluation",
  "feature_schema": {
    "columns": 304,
    "components_in_order": [
      {
        "name": "F156",
        "columns": 156
      },
      {
        "name": "T5",
        "columns": 10
      },
      {
        "name": "behavior_without_obs_days",
        "columns": 68
      },
      {
        "name": "local_rel",
        "columns": 70
      }
    ],
    "obs_days_is_model_feature": false
  },
  "split": {
